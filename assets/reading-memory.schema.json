{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reading-memory",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^M[0-9]{6,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "character",
        "timeline",
        "foreshadow"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "certainty": {
      "type": "string",
      "enum": [
        "observed",
        "reported",
        "inferred"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "state",
        "event",
        "plant",
        "advance",
        "payoff"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^C[0-9]{6,}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "chunk_id",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^M[0-9]{6,}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "id",
    "kind",
    "subject",
    "summary",
    "certainty",
    "stage",
    "evidence",
    "related_ids"
  ],
  "additionalProperties": false
}
